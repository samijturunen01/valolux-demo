# Build-time settings (all optional). Copy to .env.local for local overrides.

# Sub-path when hosted as a GitHub Pages project site, e.g. /valolux/  (default: /)
BASE_PATH=/

# Absolute site URL – enables canonical links, og:url and sitemap.xml
# SITE_URL=https://www.valolux.net

# Only set to true for the real, approved launch. Default keeps the demo out of search engines.
# ALLOW_INDEXING=false

# ---- Future integrations (NOT used by the demo) ----
# Public Apps Script web app URL that will receive the contact form
# VITE_CONTACT_ENDPOINT=
# Public reCAPTCHA *site* key. The SECRET key never goes in this file or in frontend code.
# VITE_RECAPTCHA_SITE_KEY=
